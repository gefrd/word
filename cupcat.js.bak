        <!-- PREVIEW AREA -->
        <div id="cupcat-preview-area" style="
            flex: 1; min-height: 0;
            background: #000;
            display: flex; align-items: center; justify-content: center;
            position: relative; overflow: hidden;
        ">
            <div id="cupcat-canvas" style="
