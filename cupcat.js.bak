                    border: 2px dashed #00e5ff; box-shadow: 0 0 10px rgba(0,229,255,0.45);
                    cursor: move; user-select: none; box-sizing: border-box;
                ">
                    <div class="cupcat-box-handle cupcat-bh-tl" data-handle="tl" style="position: absolute; top: -6px; left: -6px; width: 12px; height: 12px; background: #00e5ff; border: 2px solid #fff; border-radius: 50%; cursor: nwse-resize; z-index: 35;"></div>
                    <div class="cupcat-box-handle cupcat-bh-tr" data-handle="tr" style="position: absolute; top: -6px; right: -6px; width: 12px; height: 12px; background: #00e5ff; border: 2px solid #fff; border-radius: 50%; cursor: nesw-resize; z-index: 35;"></div>
                    <div class="cupcat-box-handle cupcat-bh-bl" data-handle="bl" style="position: absolute; bottom: -6px; left: -6px; width: 12px; height: 12px; background: #00e5ff; border: 2px solid #fff; border-radius: 50%; cursor: nesw-resize; z-index: 35;"></div>
                    <div class="cupcat-box-handle cupcat-bh-br" data-handle="br" style="position: absolute; bottom: -6px; right: -6px; width: 12px; height: 12px; background: #00e5ff; border: 2px solid #fff; border-radius: 50%; cursor: nwse-resize; z-index: 35;"></div>
