// src/modules/tools/cupcat.js
// CapCut-style Video Editor — full rewrite

import { FFmpeg } from '@ffmpeg/ffmpeg';
import { fetchFile, toBlobURL } from '@ffmpeg/util';
import FFmpegWorker from '@ffmpeg/ffmpeg/worker?url';

