let audioTracks = []; // { id, file, name, objectUrl, duration, startTrim, endTrim, offset }
let textOverlays = []; // { id, text, startTime, endTime, position, color, fontSize, font, posX, posY, rotation, opacity, keyframes: [] }
let overlayTracks = []; // { id, file, name, objectUrl, duration, isImage, isSticker, stickerEmoji, startTime, endTime, posX, posY, posPreset, scale, opacity, rotation, keyframes: [] }
let selectedClipId = null;
let selectedAudioId = null;
let selectedTextId = null;
let selectedOverlayId = null;
let playheadTime = 0;
let isPlaying = false;
let playInterval = null;
let _playbackClipId = null; // tracks which clip ID is currently playing in the preview, needed to detect transitions between clips that share the same source URL (e.g. split video)
let timelineZoom = 80; // pixels per second
let draggingClip = null;
let draggingAudio = null;
let splitMode = false;
let trimTarget = null; // { type: 'video'|'audio', id: string }
let volumeTarget = null; // { type: 'video'|'audio', id: string }
let volumeModalMuted = false; // pending mute toggle state while the volume modal is open
let speedTarget = null; // { type: 'video'|'audio', id: string }
let filterTarget = null; // { type: 'video', id: string }
let filterModalPending = { preset: 'none', brightness: 0, contrast: 1, saturation: 1, hue: 0, sepia: 0 };
let transformTarget = null; // { type: 'video', id: string }
let transformModalPending = { rotation: 0, flipH: false, flipV: false };
let textModalIsNew = false; // whether the text modal is currently creating a new overlay vs editing selectedTextId
let textModalEditId = null; // id of the text overlay being edited, when not creating new
let textModalPosition = 'bottom'; // pending position value while the text modal is open ('top'|'center'|'bottom')
let transitionModalClipIndex = -1; // index of the clip whose outgoing transition is being edited
let canvasAspect = '16:9'; // '16:9' | '9:16' | '1:1' — output canvas ratio, drives both preview letterboxing and export scale/pad

// Keyframe & Canvas Drag State
let activeStickerCategory = 'popular';
let canvasDraggingTarget = null; // { type: 'overlay'|'text', id: string, startX, startY, startPosX, startPosY, isHandle: boolean, handleType: string, startScale: number }

// Export Quality Settings
let exportSettings = {
    resolution: '720p',
    preset: 'ultrafast',
    quality: 'medium', // 'high' (CRF 18), 'medium' (CRF 23), 'draft' (CRF 28)
    format: 'mp4'
};

