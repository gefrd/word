+    minPixelRatio: 0.625,
+    distance: 2,
+    lambert: true,
+    clouds: true,
+    highlightEvery: 2
+  },
+  high: {
+    pixelRatio: 1,
+    minPixelRatio: 1,
+    distance: 3,
+    lambert: false,
+    clouds: true,
+    highlightEvery: 1
+  }
+}
