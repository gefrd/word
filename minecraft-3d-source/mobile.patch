+// touch devices: phones, tablets (incl. iPadOS that reports a desktop UA)
+export const isMobile =
+  /Android|webOS|iPhone|iPad|iPod|BlackBerry|Mobile/i.test(
+    navigator.userAgent
+  ) ||
+  (navigator.maxTouchPoints > 0 &&
+    window.matchMedia('(pointer: coarse)').matches)
+
+// weak device heuristic: few cores / little memory
+const nav = navigator as Navigator & { deviceMemory?: number }
+export const isLowEnd =
+  isMobile &&
+  ((navigator.hardwareConcurrency || 8) <= 4 || (nav.deviceMemory || 8) <= 3)
+
+export enum Quality {
+  low = 'low',
+  medium = 'medium',
+  high = 'high'
+}
+
+const savedQuality = (() => {
+  try {
+    return window.localStorage.getItem('quality') as Quality | null
+  } catch {
+    return null
+  }
+})()
+
+// graphics preset, chosen once at startup (switching reloads the page)
+export const quality: Quality =
+  savedQuality && savedQuality in Quality
+    ? savedQuality
+    : isMobile
+    ? isLowEnd
+      ? Quality.low
+      : Quality.medium
+    : Quality.high
+
+export const setQuality = (q: Quality) => {
+  try {
+    window.localStorage.setItem('quality', q)
+  } catch {}
+}
+
+export interface Preset {
+  // base render resolution relative to CSS pixels
+  pixelRatio: number
+  // lowest resolution the adaptive scaler may drop to
+  minPixelRatio: number
+  // render distance in chunks
+  distance: number
+  // cheap per-vertex lighting instead of PBR
+  lambert: boolean
+  clouds: boolean
+  // run the crosshair highlight raycast every N frames
+  highlightEvery: number
+}
+
+export const presets: Record<Quality, Preset> = {
+  low: {
+    pixelRatio: 0.75,
+    minPixelRatio: 0.5,
+    distance: 1,
+    lambert: true,
+    clouds: false,
+    highlightEvery: 3
+  },
+  medium: {
